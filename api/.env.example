# Copy to api/.env and fill in. Loaded by app/config.py (Settings).
#
# For the local stack, scripts/dev-up.sh writes api/.env for you (from
# `supabase status` + the seed) — you don't need to fill this in by hand.
# See docs/LOCAL_DEV.md.

# Supabase project URL. Local stack: http://127.0.0.1:54321
SUPABASE_URL=

# Service-role key (server-side only — bypasses RLS, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase user ids allowed to use the dev-profile switcher
# (impersonate another user via X-Dev-Profile). Locally these are the seeded
# @hex.local accounts; `python -m app.dev_seed` prints the line to paste here.
DEV_USER_IDS=
