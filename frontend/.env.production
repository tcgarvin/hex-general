# Production build config — committed on purpose.
#
# These are browser-safe PUBLIC values (Supabase project URL + publishable key +
# the public API URL). Vite inlines them into the client bundle at build time, so
# they are public by design; row-level security protects the data, and the secret
# service-role key lives only server-side (never here). Committing them makes the
# production `vite build` self-contained instead of depending on the deploy
# pipeline injecting env vars. The secret is RLS + the service-role key, not these.
#
# Vite loads .env.production only for production builds (`vite build`); local dev
# (`vite dev`) and a developer's .env.local are unaffected.
VITE_SUPABASE_URL=https://amhkpsrvjlthmmemwssc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_OMsFJ36R9ribKz46JsJ3BQ_cRI-Op0b
VITE_API_URL=https://hex-api-qfzj5tg56a-uc.a.run.app
