# Copy to .env.local and fill in. These are browser-safe public values.
# Vite inlines VITE_-prefixed vars into the client bundle at build time.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (recommended over the legacy anon key). Format: sb_publishable_...
VITE_SUPABASE_ANON_KEY=

# Cloud Run API base URL. Optional — defaults to the deployed service in
# src/lib/api/client.ts. Set to http://localhost:8080 to point the app at a local API.
VITE_API_URL=
